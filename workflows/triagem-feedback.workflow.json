{
  "name": "Triagem de feedback (texto + foto)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "feedback",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "bd2cc480-80ef-53e4-b977-abc9bd7af358",
      "name": "Webhook feedback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "04a4b44f-50ff-5647-9e6b-7a9b95cda514"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ Object.keys($binary ?? {}).length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f2e8e614-3055-502b-86bf-3e8c91f60e19",
      "name": "Tem imagem?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/v1/feedback/analyze",
        "authentication": "none",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "texto",
              "value": "={{ $json.body.texto }}"
            },
            {
              "parameterType": "formBinaryData",
              "name": "imagem",
              "inputDataFieldName": "={{ Object.keys($binary)[0] }}"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "id": "a9c441e3-bcb6-54d2-ba22-64f544e577dc",
      "name": "API analisa (texto + imagem)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        200
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/v1/feedback/analyze",
        "authentication": "none",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "texto",
              "value": "={{ $json.body.texto }}"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "id": "adec7af3-74d1-5c10-a3d1-3e6319e1b4fd",
      "name": "API analisa (so texto)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        400
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "texto",
              "type": "string",
              "value": "={{ $('Webhook feedback').item.json.body.texto }}"
            },
            {
              "id": "a2",
              "name": "prioridade",
              "type": "string",
              "value": "={{ $json.prioridade ?? 'indeterminada' }}"
            },
            {
              "id": "a3",
              "name": "sentimento",
              "type": "string",
              "value": "={{ $json.analise_texto?.sentimento ?? 'n/d' }}"
            },
            {
              "id": "a4",
              "name": "problema_principal",
              "type": "string",
              "value": "={{ $json.analise_texto?.problema_principal ?? 'n/d' }}"
            },
            {
              "id": "a5",
              "name": "requer_acao",
              "type": "boolean",
              "value": "={{ $json.analise_texto?.requer_acao ?? false }}"
            },
            {
              "id": "a6",
              "name": "prato",
              "type": "string",
              "value": "={{ $json.prato?.classe ?? '' }}"
            },
            {
              "id": "a8",
              "name": "confianca_prato",
              "type": "number",
              "value": "={{ $json.prato?.confianca ?? 0 }}"
            },
            {
              "id": "a7",
              "name": "latencia_ms",
              "type": "number",
              "value": "={{ $json.latencia_ms ?? 0 }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b76a567d-4e37-5ec2-9661-0eda4cc83253",
      "name": "Normalizar",
