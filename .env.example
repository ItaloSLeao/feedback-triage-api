# Copie para .env e ajuste. Não versione o .env.

# Se definida, todas as rotas /v1/* exigem o cabeçalho X-API-Key com este valor.
# Vazia ou ausente = API aberta (use só em rede local).
API_KEY=

# Repositórios dos modelos no Hugging Face Hub (ou caminhos locais).
EXTRACTOR_MODEL=aitalo/qwen2.5-0.5b-avaliacoes-ptbr
CLASSIFIER_MODEL=aitalo/convnext-tiny-comida-brasileira

# Limite de tokens gerados pelo extrator (o treino e a avaliação usaram 200).
MAX_NEW_TOKENS=200

# Penalidade de repetição na geração. Vazio = valor do generation_config.json do
# modelo (1.1), que é a configuração em que ele foi avaliado. Ver README, "Limitações".
REPETITION_PENALTY=

# Threads do PyTorch na CPU. 0 = deixar o PyTorch decidir.
TORCH_NUM_THREADS=0

# auto = usa CUDA se existir, senão CPU. Também aceita "cpu" ou "cuda".
DEVICE=auto

# Sobrescreve o limiar de rejeição do classificador. Vazio = usa o limiar.json do Hub.
CLASSIFIER_THRESHOLD=

# Limites de entrada.
MAX_TEXT_CHARS=2000
MAX_IMAGE_BYTES=5242880

LOG_LEVEL=INFO
